# Binance Hunter - Example Environment File
# Copy this to .env and fill in your values
# NEVER commit .env to version control!

# Binance API Credentials
# Get these from https://www.binance.com/en/my/api-management
# Enable SPOT trading permission only (no withdrawals)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Hunter Configuration
HUNTER_PORT=4564
HUNTER_START_BALANCE=100.0
HUNTER_TARGET_BALANCE=200.0
RISK_PER_TRADE=0.10
MAX_POSITIONS=3
# Paper trading mode: 0 = paper (no real orders), 1 = live
HUNTER_LIVE_ORDERS=0

# Telegram push cards (entries / signals / placed trades / daily-weekly results)
# Create a bot via @BotFather, then get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# PRE-PUMP cards only (comma separated extra chat ids)
TELEGRAM_PREPUMP_CHAT_ID=

# ---- Signal gates (upgraded 2026-11) ----
HUNT_MIN_SCORE=45     # order-flow score floor
HUNT_MIN_VOL=1.5      # volume vs baseline
HUNT_MIN_MOM=0.8      # % move over 5m
HUNT_MIN_IMBAL=0.50   # buy-side share of the book

# Pre-pump depth & minimum coil score
PREPUMP_MIN_DEPTH=10000
PREPUMP_ENTRY=50      # pre-pump score required by the early path

# First-Move Radar
FIRSTMOVE_MIN=55      # pregain score required to fire
FIRSTMOVE_MIN_VOL=1.0 # a pre-gainer still needs volume arriving

# Structure & Fib/Gann
DEEP_KLINES=240       # 1m bars pulled per deep-scan symbol
CATALYST_RISK=0.06    # catalyst entries risk less than flow entries (5% vs 10%)

# Timezone for the bot windows/cards and the dashboard clock + chart axis
HUNTER_TZ=America/New_York
# ---- AltFins chart-pattern + signals feed (altfins.com) ----
ALTFINS_API_KEY=your_altfins_api_key_here
ALTFINS_BASE=https://altfins.com
ALTFINS_ENABLED=1